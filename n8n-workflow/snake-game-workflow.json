{"name": "Snake Game Score Processor", "nodes": [{"parameters": {"httpMethod": "POST", "path": "snake-game-score", "responseMode": "responseNode", "options": {}}, "type": "n8n-nodes-base.webhook", "typeVersion": 2, "id": "webhook-trigger", "name": "Webhook - Score Received", "position": [0, 0]}, {"parameters": {"assignments": {"assignments": [{"id": "1", "name": "playerName", "value": "={{ $json.playerName }}", "type": "string"}, {"id": "2", "name": "score", "value": "={{ Number($json.score) }}", "type": "number"}, {"id": "3", "name": "level", "value": "={{ Number($json.level) }}", "type": "number"}, {"id": "4", "name": "date", "value": "={{ $json.date }}", "type": "string"}, {"id": "5", "name": "isRecord", "value": "={{ $json.score >= 100 ? true : false }}", "type": "boolean"}]}}, "options": {}, "type": "n8n-nodes-base.set", "typeVersion": 3.4, "id": "process-data", "name": "Process & Validate", "position": [220, 0]}, {"parameters": {"conditions": {"options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict"}, "conditions": [{"id": "record-check", "leftValue": "={{ $json.isRecord }}", "rightValue": true, "type": "boolean"}]}, "executionOrder": "sequential"}, "type": "n8n-nodes-base.if", "typeVersion": 2, "id": "record-check", "name": "Is Record Score?", "position": [440, 0]}, {"parameters": {"jsCode": "const score = $input.first().json.score;\nconst name = $input.first().json.playerName;\nreturn [{\n  json: {\n    ...$input.first().json,\n    achievement: `\\uD83C\\uDF86 ${name} reached a RECORD with ${score} points!`,\n    badge: 'GOLD',\n    rank: 'Elite'\n  }\n}];"}, "type": "n8n-nodes-base.code", "typeVersion": 2, "id": "record-badge", "name": "Award Record Badge", "position": [660, -240]}, {"parameters": {"jsCode": "const score = $input.first().json.score;\nconst name = $input.first().json.playerName;\nreturn [{\n  json: {\n    ...$input.first().json,\n    achievement: `${name} scored ${score} points`,\n    badge: 'NORMAL',\n    rank: score >